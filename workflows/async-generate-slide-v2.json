      "parameters": {
        "jsCode": "// 1. Get the raw string from the previous node\nlet rawString = $input.item.json.data;\n\n// 2. Un-escape the first layer if n8n double-wrapped it in quotes\nif (typeof rawString === 'string' && rawString.startsWith('\"') && rawString.endsWith('\"')) {\n  try { \n    rawString = JSON.parse(rawString); \n  } catch (e) {\n    // silently continue if it fails\n  }\n}\n\n// 3. Strip out any Markdown backticks and 'json' labels\nlet cleanText = rawString.replace(/```json/gi, '').replace(/```/gi, '').trim();\n\nlet parsedData;\n\n// 4. Parse the clean text\ntry {\n  parsedData = JSON.parse(cleanText);\n  \n  // 5. The Magic Fix: If it is STILL a string after parsing, parse it one more time!\n  if (typeof parsedData === 'string') {\n    parsedData = JSON.parse(parsedData);\n  }\n} catch (error) {\n  return [{ json: { error: \"Failed to parse JSON completely\", raw: cleanText } }];\n}\n\n// 6. Return the actual array of objects in n8n's required format\nreturn {\n    sections: parsedData \n  };"
      },
