        "query": "=[\n  {\n    \"$match\": {\n      \"courseId\": \"{{ $json.params.courseId }}\"\n    }\n  },\n  {\n    \"$lookup\": {\n      \"from\": \"exercises\",\n      \"localField\": \"lessonIds\",\n      \"foreignField\": \"lessonId\",\n      \"as\": \"exercises\"\n    }\n  },\n  {\n    \"$unwind\": \"$exercises\"\n  },\n  {\n    \"$group\": {\n      \"_id\": \"$exercises.lessonId\",\n      \"maxScore\": { \"$max\": \"$exercises.score\" }\n    }\n  },\n  {\n    \"$group\": {\n      \"_id\": null,\n      \"avgMaxScore\": { \"$avg\": \"$maxScore\" }\n    }\n  },\n  {\n    \"$project\": {\n      \"_id\": 0,\n      \"avgMaxScore\": 1\n    }\n  }\n]\n"
