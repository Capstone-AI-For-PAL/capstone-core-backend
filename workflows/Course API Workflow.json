    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst preparedAnswers = $('Prepare Answer').first().json.answer || [];\n\n// Build answer map safely\nconst answerMap = new Map();\nfor (const item of preparedAnswers) {\n  if (item?.number !== undefined) {\n    answerMap.set(item.number, item.answer ?? null);\n  }\n}\n\nconst newQuestions = (input.questions || []).map(q => {\n  const userAnswer = answerMap.has(q.number)\n    ? answerMap.get(q.number)\n    : null;\n\n  const isCorrect = userAnswer === q.correctAnswer;\n\n  return {\n    ...q,\n    answer: userAnswer,\n    isCorrect: isCorrect\n  };\n});\n\n// Calculate score safely\nconst totalScore = newQuestions.reduce((sum, q) => {\n  return sum + (q.isCorrect ? (q.score || 0) : 0);\n}, 0);\n\nreturn [\n  {\n    json: {\n      exerciseId: input.exerciseId,\n      questions: newQuestions,\n      score: totalScore ?? 0,\n      submittedAt: new Date()\n    }\n  }\n];\n"
      },
