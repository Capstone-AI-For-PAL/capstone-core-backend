        "query": "=[\n  {\n    \"$match\": {\n      \"lessonId\": \"{{ $json.params.lessonId }}\"\n    }\n  },\n  {\n    \"$group\": {\n      \"_id\": null,\n      \"maxScore\": { \"$max\": \"$score\" }\n    }\n  },\n  {\n    \"$project\": {\n      \"_id\": 0,\n      \"maxScore\": 1\n    }\n  }\n]\n"
